{
  "opencollection": "1.0.0",
  "info": {
    "name": "Business Accounting Webhooks (v1) (deprecated) API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks (v1) (deprecated)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://b2b.revolut.com/api/1.0/webhook",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get your webhook URL."
        },
        {
          "info": {
            "name": "Set a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://b2b.revolut.com/api/1.0/webhook",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Set up a webhook URL so that event notifications are pushed to the specified URL. Only HTTPS URLs are supported."
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://b2b.revolut.com/api/1.0/webhook",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a webhook so that events are not sent to the specified URL any more."
        }
      ]
    }
  ],
  "bundled": true
}