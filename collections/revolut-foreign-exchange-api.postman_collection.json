      "id": "47f79288-5789-44d9-92a6-cdbcefc476a2",
      "name": "Foreign exchange",
      "description": {
        "content": "Retrieve information on exchange rates between currencies, buy and sell currencies.\n\nFor more information, see the guides: [Exchange money](https://developer.revolut.com/docs/guides/manage-accounts/exchange-money).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "871ce6d8-598d-44f3-9b6c-8be5f64ecc0a",
          "name": "Get an exchange rate",
          "request": {
            "name": "Get an exchange rate",
            "description": {
              "content": "Get the sell exchange rate between two currencies.\n\nYou can check the [currencies supported in Production](https://help.revolut.com/business/help/receiving-payments/currency-exchanges/which-currencies-can-i-exchange-and-keep-in-my-account/) in the Revolut Help Centre.\nSome of these currencies might not be available in Sandbox.\n\nFor more information, see the guides: [Exchange money](https://developer.revolut.com/docs/guides/manage-accounts/exchange-money).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) The currency that you exchange from in [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217) format."
                },
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "1.00",
                  "description": "The amount of the currency to exchange **from**. The default value is `1.00`."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) The currency that you exchange to in [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217) format."
                }
