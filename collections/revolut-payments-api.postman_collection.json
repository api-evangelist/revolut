        {
          "id": "2cf67092-e5d9-4ccc-af4c-edeeeedd704c",
          "name": "Retrieve payment details",
          "request": {
            "name": "Retrieve payment details",
            "description": {
              "content": "Retrieve information about a specific payment, based on the payment's ID.\n\nUse this endpoint to track a payment's lifecycle, for example:\n  - When you develop a [1-click checkout process](https://developer.revolut.com/docs/guides/merchant/optimise-checkout/save-payment-methods/checkout-with-saved-card)\n  - When you build a [subscription management system](https://developer.revolut.com/docs/guides/merchant/optimise-checkout/save-payment-methods/subscription-management)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
