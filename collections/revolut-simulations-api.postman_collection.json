  "item": [
    {
      "id": "a1985cea-f65a-40d5-8233-c522f205514b",
      "name": "Simulations",
      "description": {
        "content": "The Simulations API is only available in the Sandbox environment. \nIt lets you simulate certain events that are otherwise only possible in the production environment, such as your account's top-up and transfer state changes. \n\nFor more information, see the guides: [Test your flows with simulations (Sandbox only)](https://developer.revolut.com/docs/guides/manage-accounts/api-usage-and-testing/test-flows-with-simulations).\n\n:::note\nTo play around with Sandbox, [create a Sandbox account](https://sandbox-business.revolut.com/).\n:::",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "082a1fa6-a35e-4ce7-aeac-25e16d1242aa",
          "name": "Simulate a transfer state update (Sandbox only)",
          "request": {
            "name": "Simulate a transfer state update (Sandbox only)",
            "description": {
              "content": "Simulate a transfer state change in the Sandbox environment. \n\nFor example, after you make a transfer in Sandbox, you can change its state to `completed`. The resulting state is final and cannot be changed.\n\nFor more information, see the guides: [Test your flows with simulations (Sandbox only)](https://developer.revolut.com/docs/guides/manage-accounts/api-usage-and-testing/test-flows-with-simulations).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sandbox",
                "transactions",
                ":id",
                ":action"
              ],
              "host": [
                "{{sandbox-transactions-id-action-Url}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) The ID of the transfer whose state you want to update."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "action",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
