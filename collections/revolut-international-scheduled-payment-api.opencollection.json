            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://b2b.revolut.com/api/1.0/international-scheduled-payment-consents",
            "headers": [
              {
                "name": "x-fapi-financial-id",
                "value": ""
              },
              {
                "name": "x-fapi-customer-last-logged-time",
                "value": ""
              },
              {
                "name": "x-fapi-customer-ip-address",
                "value": ""
              },
              {
                "name": "x-fapi-interaction-id",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
