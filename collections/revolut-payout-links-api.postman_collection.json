{
  "item": [
    {
      "id": "c7766744-dd97-45e0-910f-a6075525c2d1",
      "name": "Payout links",
      "description": {
        "content": "Use payout links to send money without having to request full banking details of the recipient.  \nThe recipient must claim the money before the link expires.\n\n:::note\nThis feature is available in the UK, the EEA, AU, and SG.\n:::\n\nFor more information, see the guides: [Send money via payout link](https://developer.revolut.com/docs/guides/manage-accounts/transfers/payout-links).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "310d5d70-55df-4f64-84f8-949f6adadcb7",
          "name": "Create a payout link",
          "request": {
            "name": "Create a payout link",
            "description": {
              "content": "Create a payout link to send money even when you don't have the full banking details of the counterparty.  \nAfter you have created the link, send it to the recipient so that they can claim the payment.\n\n:::note\nThis feature is available in the UK, the EEA, AU, and SG.\n:::\n\nFor more information, see the guides: [Send money via payout link](https://developer.revolut.com/docs/guides/manage-accounts/transfers/payout-links).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "payout-links"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
